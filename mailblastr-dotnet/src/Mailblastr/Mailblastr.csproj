<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mailblastr</RootNamespace>

    <PackageId>Mailblastr</PackageId>
    <Version>1.0.0</Version>
    <Authors>MailBlastr</Authors>
    <Company>MailBlastr</Company>
    <Description>Official MailBlastr .NET SDK — send transactional and marketing email from your own verified domain. Emails, batch sends, inbound email, domains, contacts, segments, topics, campaigns, templates, automations, webhooks and more.</Description>
    <PackageTags>email;mailblastr;transactional;marketing;smtp;api</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.mailblastr.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shekhu10/mailblastr-sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
